# ══════════════════════════════════════════════════════════════
# WAJIB DIISI — bot GAK AKAN JALAN tanpa ini
# ══════════════════════════════════════════════════════════════
API_ID=                          # dari my.telegram.org — angka ID aplikasi Telegram kamu
API_HASH=                        # dari my.telegram.org — pasangan API_ID
BOT_TOKEN=                       # token bot utama dari @BotFather
OWNER_ID=                        # user ID Telegram kamu (angka) — akses penuh/owner panel
MONGO_URL=                       # link koneksi MongoDB utama (cluster 0 / config)
MONGO_DB_NAME=                   # nama database Mongo yang dipakai

# ── DNS custom (opsional) — pengaruh ke SEMUA koneksi: Telegram, Gemini, ──────
# ── Groq, OpenRouter (Mongo SRV lookup punya resolver sendiri, tidak ikut) ────
CUSTOM_DNS_ENABLED=1             # 1=pakai DNS custom di bawah, 0=balik ke DNS default jaringan HP/Termux
CUSTOM_DNS_SERVERS=1.1.1.1,1.0.0.1  # DNS server custom, dipisah koma (default Cloudflare)

# ══════════════════════════════════════════════════════════════
# KREDENSIAL/FITUR PENTING — isi kalau fiturnya dipakai
# ══════════════════════════════════════════════════════════════
LOG_CHANNEL=                     # ID channel Telegram (angka) tempat bot kirim log aktivitas
CHANNEL_OWNER=                   # ID channel referensi owner (dipakai UI Security OS) — isi 0 kalau gak punya
GROUP_LIST_IMAGE=                # link gambar Telegraph buat banner panel daftar grup
QRIS_IMAGE_URL=                  # link gambar QRIS buat panel donasi
RULES_LINK_URL=                  # link aturan grup, ditampilkan di beberapa menu
PANDUAN_OS=                      # link/isi teks panduan Security OS
SESSION_SECRET=                  # kunci rahasia enkripsi session — isi string acak panjang, JANGAN dibagikan
SQLITE_PATH=                     # lokasi file database lokal (fallback kalau Mongo mati)
ADMIN_FLASH_USER_ID=             # ID user yang dapat notifikasi "flash" khusus admin
USERBOT_PHONE=                   # nomor HP userbot utama (format internasional, misal 628xxxx)
CODE_BOT=                        # kode/label identitas bot (dipakai di beberapa pesan sistem)
PORT=8000                        # port HTTP internal (dipakai host/panel, biarkan default)

# ══════════════════════════════════════════════════════════════
# MONGODB SHARDING — cluster tambahan (opsional, biar gak numpuk di 1 cluster)
# ══════════════════════════════════════════════════════════════
MONGO_URL_2=                     # cluster tambahan #1 (hotpath — data per-pesan)
MONGO_URL_3=                     # cluster tambahan #2 (hotpath — data per-pesan)
MONGO_URL_4=                     # cluster tambahan #3 (data lintas-grup/global)
MONGO_URL_5=                     # cluster tambahan #4 (khusus log)
MONGO_URL_6=                     # cluster tambahan #5 (khusus analytics)
MONGO_OPS_PER_MIN_LIMIT=95       # batas operasi/menit per cluster sebelum dianggap penuh
MONGO_SHARD_DOWN_STREAK=3        # berapa kali gagal beruntun sebelum cluster dianggap down
MONGO_SHARD_UP_STREAK=2          # berapa kali sukses beruntun sebelum cluster dianggap pulih
MONGO_SHARD_HEALTH_INTERVAL=30   # detik — interval cek kesehatan tiap cluster
MONGO_SHARD_HEALTH_GRACE_START=30 # detik — masa tenggang saat bot baru nyala sebelum mulai cek

# ══════════════════════════════════════════════════════════════
# BOT BENGKEL (workshop pool) — token bot cadangan buat add member dll
# ══════════════════════════════════════════════════════════════
TOKEN_BACKUP1=                   # token bot cadangan #1 dari @BotFather
TOKEN_BACKUP2=                   # token bot cadangan #2 (boleh tambah TOKEN_BACKUP3, 4, dst tanpa batas)
WORKSHOP_TOKEN_MIN_GAP_SECS=1    # jeda minimal antar pemakaian 1 token yang sama
WORKSHOP_POLL_INTERVAL_SECS=30   # interval cek status worker bengkel
WORKSHOP_FETCH_TIMEOUT_SECS=12   # timeout ambil data dari Telegram API per worker
WORKSHOP_JOIN_VERIFY_DELAY_SECS=5   # jeda sebelum verifikasi worker berhasil join grup
WORKSHOP_JOIN_VERIFY_RETRIES=3   # berapa kali retry verifikasi join
WORKSHOP_LEAVE_STAGGER_SECS=2    # jeda acak antar worker keluar grup (hindari flood)
WORKSHOP_BOOT_INITIAL_DELAY_SECS=5  # jeda sebelum worker pertama mulai saat bot baru nyala
WORKSHOP_BOOT_START_STAGGER_SECS=2  # jeda antar worker mulai satu-satu saat boot
WORKSHOP_SAFE_SECS=5             # jeda aman tambahan sebelum aksi sensitif worker

# ══════════════════════════════════════════════════════════════
# API KEY AI — Groq, Gemini, OpenRouter (boleh banyak key, pisah koma)
# ══════════════════════════════════════════════════════════════
GROQ_API_KEYS=                   # banyak key Groq dipisah koma — dipakai antispam AI + VC Chatter prioritas#1 + DM Chat fallback
GROQ_API_KEY=                    # alternatif kalau cuma 1 key Groq
GROQ_MODEL=                      # nama model Groq yang dipanggil
GEMINI_API_KEYS=                 # banyak key Gemini dipisah koma — dipakai VC Chatter fallback#2 + DM Chat prioritas#1
GEMINI_API_KEY=                  # alternatif kalau cuma 1 key Gemini
GEMINI_MODEL=gemini-flash-latest # nama model Gemini
GEMINI_MAX_CALLS_PER_MIN=12      # limiter lokal — maks panggilan/menit PER key
GEMINI_MAX_CALLS_PER_DAY=1200    # limiter lokal — maks panggilan/hari PER key
OPENROUTER_API_KEYS=             # banyak key OpenRouter dipisah koma — KHUSUS AI Manual (training Bayes/PatternMemory)
OPENROUTER_API_KEY=              # alternatif kalau cuma 1 key OpenRouter
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free  # model dipakai buat training AI manual
OPENROUTER_MAX_CALLS_PER_MIN=12  # limiter lokal — maks panggilan/menit PER key
OPENROUTER_MAX_CALLS_PER_DAY=1200 # limiter lokal — maks panggilan/hari PER key
AI_MANUAL_BATCH_SIZE=250         # jumlah kalimat per panggilan OpenRouter saat training
FUZZY_BATCH_SIZE=200             # jumlah kalimat dikumpulkan per batch sebelum training
FUZZY_BATCH_QUEUE_MAXSIZE=2000   # kapasitas maksimal antrian kalimat menunggu diproses batch
FUZZY_BATCH_COLLECT_WAIT=5.0     # detik — tunggu setelah item pertama masuk sebelum batch diproses (biar sempat kekumpul rame)
FUZZY_BATCH_DELAY_SECONDS=2.0    # detik — jeda antar batch training beruntun
OCR_SPACE_API_KEY=               # API key OCR.space (baca teks dari gambar, misal bukti donasi)
OCR_SPACE_ENDPOINT=              # endpoint API OCR.space (biarkan default kalau gak tahu)
OCR_HTTP_TIMEOUT=15              # detik — timeout request ke OCR API

# ══════════════════════════════════════════════════════════════
# PROMO USERBOT — VC auto-typing (fitur VIPBIO)
# ══════════════════════════════════════════════════════════════
PROMO_VC_CHAT_ENABLED=0          # 1=aktifkan fitur auto-typing chat VC promo, 0=mati
PROMO_VC_CHAT_TICK_SECS=5        # interval loop utama cek giliran akun & eligibility
PROMO_VC_CHAT_MIN_ACCOUNT_GAP=86.4  # jarak minimal (detik) antar "tembakan" AI baru utk akun yang sama
PROMO_VC_CHAT_MIN_CLUSTER_INTERVAL=5.0  # jeda tambahan saat giliran pindah ke akun lain
PROMO_VC_CHAT_SEND_STAGGER_MIN=2 # jeda acak minimal (detik) sebelum kirim ke grup berikutnya
PROMO_VC_CHAT_SEND_STAGGER_MAX=6 # jeda acak maksimal (detik) sebelum kirim ke grup berikutnya
PROMO_VC_CHAT_CHUNK_CHARS=30     # panjang maksimal per potongan teks yang dicicil
PROMO_VC_CHAT_MAX_SEND_CHARS=60  # batas karakter maksimal 1x kirim ke kolom chat VC
PROMO_VC_CHAT_CONTEXT_N=5        # jumlah pesan riwayat VC dikirim sebagai konteks ke AI
PROMO_VC_CHAT_MAX_CHARS_PER_TEXT=25  # batas karakter tiap potongan konteks yang dikirim ke AI
PROMO_VC_CHAT_STRIP_NON_BMP=0    # 1=buang emoji/karakter aneh dari balasan AI
PROMO_VC_CHAT_FAIL_THRESHOLD=2   # berapa kali gagal kirim beruntun sebelum grup di-pause
PROMO_VC_CHAT_PAUSE_COOLDOWN_SECS=1800  # lama pause (detik) setelah kena fail threshold — 1800=30 menit
PROMO_VC_CHAT_SETTLE_AFTER_JOIN_SECS=45 # jeda adaptasi setelah akun join VC sebelum boleh kirim pesan
PROMO_VC_CHAT_RETRY_SETTLE_BUFFER_SECS=15  # buffer tambahan settle time saat retry join

# ══════════════════════════════════════════════════════════════
# PROMO USERBOT — DM Chat (obrolan privat otomatis bermemori)
# ══════════════════════════════════════════════════════════════
PROMO_DM_CHAT_ENABLED=0          # 1=aktifkan auto-reply DM promo, 0=mati
PROMO_DM_CHAT_REPLY_DELAY_MIN_SECS=60   # jeda minimal (detik) sebelum bot balas DM
PROMO_DM_CHAT_REPLY_DELAY_MAX_SECS=600  # jeda maksimal (detik) sebelum bot balas DM
PROMO_DM_CHAT_SILENCE_TOKEN=[DIAM]      # kata kunci khusus dari AI supaya bot diam/gak balas
PROMO_DM_CHAT_MAX_HISTORY=40     # jumlah pesan riwayat DM yang diingat sebagai konteks
PROMO_DM_CHAT_TYPING_CHARS_PER_SEC=12   # kecepatan simulasi mengetik (karakter/detik)
PROMO_DM_CHAT_TYPING_MIN_SECS=1.5       # durasi minimal animasi "sedang mengetik"
PROMO_DM_CHAT_TYPING_MAX_SECS=6.0       # durasi maksimal animasi "sedang mengetik"
PROMO_DM_CHAT_READ_TO_TYPING_GAP_MIN_SECS=1  # jeda minimal antara "pesan dibaca" ke mulai mengetik
PROMO_DM_CHAT_READ_TO_TYPING_GAP_MAX_SECS=4  # jeda maksimal antara "pesan dibaca" ke mulai mengetik

# ══════════════════════════════════════════════════════════════
# PROMO USERBOT — Join & sinkronisasi daftar grup
# ══════════════════════════════════════════════════════════════
PROMO_UB_GROUP_SYNC_INTERVAL=1800  # detik — interval auto-sync daftar grup dari dialog Telegram (1800=30 menit)
PROMO_UB_GROUP_SYNC_MIN_GAP=15   # jeda minimal antar klik refresh manual daftar grup
PROMO_UB_GROUP_SYNC_ITEM_PACE_MIN=1  # jeda acak minimal antar item saat sync
PROMO_UB_GROUP_SYNC_ITEM_PACE_MAX=3  # jeda acak maksimal antar item saat sync
PROMO_UB_ROUND_INTERVAL=600      # detik — interval siklus join grup baru (600=10 menit)
PROMO_UB_JOIN_MIN=8              # jeda acak minimal (detik) antar join grup baru
PROMO_UB_JOIN_MAX=20             # jeda acak maksimal (detik) antar join grup baru
PROMO_UB_JOIN_WORKER_STARTUP_JITTER_MIN=1  # jeda acak minimal saat worker join mulai jalan
PROMO_UB_JOIN_WORKER_STARTUP_JITTER_MAX=5  # jeda acak maksimal saat worker join mulai jalan
PROMO_ACCESS_CHECK_INTERVAL=300  # detik — interval cek ulang akses/izin akun promo
PROMO_DONATION_MAX_HARI=30       # maksimal hari donasi bisa diklaim sekaligus
PROMO_DONATION_RP_PER_HARI=1000  # nominal Rupiah per 1 hari donasi

# ══════════════════════════════════════════════════════════════
# ANTISPAM — worker & auto-scaling
# ══════════════════════════════════════════════════════════════
ANTISPAM_DETECT_DELAY=0          # jeda (detik) sebelum mulai proses deteksi pesan baru
ANTISPAM_GROUP_QUEUE_MAXSIZE=500 # kapasitas maksimal antrian pesan per grup
ANTISPAM_GROUP_TEARDOWN_STREAK=5 # berapa kali gagal beruntun sebelum worker grup dimatikan
ANTISPAM_GROUP_WORKER_MAX=6      # jumlah maksimal worker antispam per grup
ANTISPAM_GROUP_WORKER_MIN=1      # jumlah minimal worker antispam per grup
ANTISPAM_MENTION_TIMEOUT=10      # detik — timeout cek mention lewat API
ANTISPAM_SCALE_DOWN_STREAK=5     # berapa kali sepi beruntun sebelum worker dikurangi
ANTISPAM_SCALE_INTERVAL=30       # detik — interval evaluasi naik/turun jumlah worker
ANTISPAM_SCALE_UP_STREAK=5       # berapa kali padat beruntun sebelum worker ditambah
MOD_QUEUE_MAXSIZE=500            # kapasitas antrian moderasi (mute/ban/delete)
SPAM_MUTE_THRESHOLD=3            # jumlah pelanggaran sebelum user di-mute otomatis
GIBBERISH_MIN_LEN=8              # panjang karakter minimal teks dianggap gibberish/acak
STICKER_REPORT_THRESHOLD=3       # jumlah laporan stiker sebelum ditindak

# ══════════════════════════════════════════════════════════════
# NEXUS AI — pipeline klaim spam (/spam command)
# ══════════════════════════════════════════════════════════════
SPAM_CLAIM_BATCH_SIZE=20         # jumlah klaim spam diproses per batch
SPAM_CLAIM_MAX_RETRIES=3         # maksimal retry kalau proses klaim gagal
SPAM_CLAIM_POLL_INTERVAL=2       # detik — interval cek antrian klaim baru
SPAM_CLAIM_TTL_SECONDS=600       # detik — masa berlaku 1 klaim sebelum kadaluarsa
NEXUS_RECORD_MAX=500             # maksimal jumlah data mentah tersimpan di panel "Record Data"

# ══════════════════════════════════════════════════════════════
# BIO GUARD / MENTION SCAN / VC BIO LINK — deteksi bio & mention mencurigakan
# ══════════════════════════════════════════════════════════════
BIO_ACTIVE_WINDOW_SECS=3600      # detik — jendela waktu bio dianggap "aktif baru diubah"
BIO_ENQUEUE_TIMEOUT_SECS=10      # timeout masukin bio ke antrian pengecekan
BIO_FILL_DELAY_SECS=2            # jeda sebelum mengisi ulang data bio
BIO_QUEUE_DELAY=1                # jeda antar proses di antrian bio
BIO_RECHECK_SECS=1800            # detik — interval cek ulang bio user (30 menit)
BIO_TTL_JITTER_SECS=300          # variasi acak (detik) masa berlaku cache bio
BIO_TTL_SECS=86400               # detik — masa berlaku cache bio (86400=1 hari)
NS_ACTION_DELAY=1                # jeda sebelum eksekusi aksi (mute/kick) dari NS bio guard
NS_BIO_SWEEP_HOUR=3              # jam (0-23) jadwal sapuan bio harian
NS_BIO_SWEEP_MINUTE=0            # menit jadwal sapuan bio harian
NS_FLUSH_INTERVAL=60             # detik — interval flush data NS ke database
NS_RESET_CONCURRENCY=5           # jumlah proses reset paralel maksimal
MENTION_BIO_SCAN_BATCH_SIZE=20   # jumlah kandidat diproses per batch scan mention/bio
MENTION_BIO_SCAN_KANDIDAT_GAP=1  # jeda antar kandidat dalam 1 batch
MENTION_BIO_SCAN_LOOP_INTERVAL=30 # detik — interval loop scan mention/bio
MENTION_BIO_SCAN_MAX_KANDIDAT=200 # maksimal kandidat diproses sekali jalan
MENTION_PENDING_API_GAP=1        # jeda antar panggilan API utk cek mention pending
MENTION_PENDING_BATCH_SIZE=20    # jumlah mention pending diproses per batch
MENTION_PENDING_CHECK_INTERVAL=30 # detik — interval cek ulang mention pending
MENTION_PENDING_RETRY_MAX=3      # maksimal retry cek mention pending
VC_BIO_LINK_BATCH_SIZE=20        # jumlah kandidat diproses per batch scan link di bio saat VC
VC_BIO_LINK_KANDIDAT_GAP=1       # jeda antar kandidat
VC_BIO_LINK_LOOP_INTERVAL=30     # detik — interval loop scan bio-link VC

# ══════════════════════════════════════════════════════════════
# VC / VOICE CALL — join, monitoring, userbot custom
# ══════════════════════════════════════════════════════════════
VC_JOIN_RECHECK_SECS=30          # detik — interval cek ulang status join VC
VC_JOIN_SETTLE_SECS=5            # jeda adaptasi setelah join VC sebelum mulai aksi
VC_UNKNOWN_PEER_GRACE_AFTER=60   # detik — toleransi setelah muncul peer tak dikenal di VC
VC_UNKNOWN_PEER_WAIT_BEFORE=30   # detik — tunggu sebelum tindak lanjut peer tak dikenal
VC_WARN_GRACE_AFTER=60           # detik — toleransi setelah peringatan VC dikirim
VC_WARN_WAIT_BEFORE=30           # detik — tunggu sebelum kirim peringatan VC
CUSTOM_UB_STAY_INTERVAL=1800     # detik — interval custom userbot stay-VC melakukan re-check (butuh py-tgcalls)
MAIN_UB_MULTI_INTERVAL=1800      # detik — interval userbot utama scheduled-join VC banyak grup
MAIN_UB_MULTI_VC=0               # 1=aktifkan mode multi-VC userbot utama
REWARM_CHAT_DELAY=3.0            # detik — jeda "pemanasan" ulang koneksi chat setelah reconnect

# ══════════════════════════════════════════════════════════════
# DELETE / MODERATION WORKER — hapus pesan, kick, dsb
# ══════════════════════════════════════════════════════════════
DELETE_BATCH_WINDOW=2            # detik — jendela pengumpulan pesan sebelum dihapus sekaligus
DELETE_CATEGORY_JITTER=1         # variasi acak jeda per kategori hapus
DELETE_IDLE_SECS=60              # detik — dianggap idle kalau tidak ada pesan sekian detik
DELETE_IDLE_TIMEOUT=300          # detik — worker delete berhenti kalau idle terlalu lama
DELETE_INTERVAL_FLASH=1          # detik — interval hapus utk mode cepat/flash
DELETE_INTERVAL_SLOW=5           # detik — interval hapus utk mode lambat
BANGRUP_LEAVE_DELAY=5            # detik — jeda sebelum bot keluar dari grup yang di-ban
JOIN_PERM_CHECK_DELAY=5          # detik — jeda cek izin admin setelah join grup baru
PERM_WATCHDOG_DELAY=5            # detik — jeda awal watchdog cek izin admin
PERM_WATCHDOG_INTERVAL=1800      # detik — interval watchdog cek ulang izin admin (30 menit)
PERM_WATCHDOG_STRIKES=3          # jumlah pelanggaran izin sebelum ditindak
SPECIAL_BAN_IDS=                 # user ID khusus dipisah koma (misal: 7411619973,123456789) — kalau salah satu ID ini kedeteksi DI-BAN di grup manapun, bot auto-leave grup itu. Kosongkan kalau tidak dipakai.

# ══════════════════════════════════════════════════════════════
# LOGGING
# ══════════════════════════════════════════════════════════════
LOG_BATCH_MIN_ENTRIES=10         # minimal jumlah entry log sebelum dikirim batch
LOG_FLUSH_INTERVAL=60            # detik — interval kirim log terkumpul ke channel
LOG_IDLE_FLUSH_SECS=30           # detik — kirim log walau belum penuh kalau sudah idle sekian lama
LOG_QRIS=0                       # ID channel/angka log khusus transaksi QRIS — isi 0 kalau gak dipakai

# ══════════════════════════════════════════════════════════════
# MONITOR BOT
# ══════════════════════════════════════════════════════════════
MONITOR_DEAD_SIGNAL_THRESHOLD=3  # jumlah sinyal hilang beruntun sebelum akun dianggap mati
MONITOR_GATE_INTERVAL=30         # detik — interval pengecekan gate monitor

# ══════════════════════════════════════════════════════════════
# DM PEER / FEEDBACK / DETEKSI USERBOT LAIN
# ══════════════════════════════════════════════════════════════
DM_PEER_DEBOUNCE_TTL=5           # detik — cegah proses DM ganda dalam rentang ini
FEEDBACK_COOLDOWN_SECS=60        # detik — jeda user boleh kirim feedback lagi
FEEDBACK_MAX_CHARS=500           # panjang maksimal teks feedback
FEEDBACK_MIN_CHARS=5             # panjang minimal teks feedback
UBOT_COUNT_THRESHOLD=3           # jumlah indikasi sebelum akun dicurigai userbot orang lain
UBOT_MAX_SENTENCES=5             # maksimal kalimat dianalisa buat deteksi userbot
UBOT_TTL_DAYS=7                  # hari — masa berlaku data deteksi userbot

# ══════════════════════════════════════════════════════════════
# LAIN-LAIN
# ══════════════════════════════════════════════════════════════
CAST_DELAY_SECS=1                # jeda (detik) antar pesan saat broadcast/cast ke banyak grup
CAST_PROGRESS_EVERY=50           # kirim update progress broadcast tiap sekian grup
SPEED_BOOST_CHECK_INTERVAL=30    # detik — interval cek fitur speed boost
ADMIN_CACHE_TTL=300              # detik — masa berlaku cache daftar admin grup
DONATION_MAX_HARI=30             # maksimal hari donasi (versi umum, di luar promo)
DONATION_RP_PER_HARI=1000        # nominal Rupiah per hari (versi umum, di luar promo)
